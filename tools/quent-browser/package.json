{
  "name": "duckdb-quent-browser",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@11.19.0",
  "engines": {
    "node": ">=24.11.0",
    "pnpm": ">=11.19.0"
  },
  "scripts": {
    "quent:prepare": "bash scripts/prepare-quent.sh",
    "quent:bindings": "cargo run --manifest-path .quent/Cargo.toml --package quent-query-engine-ui-bindings --locked",
    "analyzer:build": "bash scripts/build-analyzer.sh",
    "assets:stamp": "node scripts/stamp-manifest.mjs",
    "dev": "vite",
    "build": "pnpm quent:bindings && pnpm assets:stamp && vite build && tsc --noEmit && node scripts/check-dist.mjs",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "check": "pnpm test && pnpm build"
  },
  "dependencies": {
    "@quent/client": "workspace:*",
    "@quent/components": "workspace:*",
    "@quent/hooks": "workspace:*",
    "@quent/utils": "workspace:*",
    "@base-ui/react": "^1.7.0",
    "@radix-ui/react-accordion": "^1.2.20",
    "@radix-ui/react-collapsible": "^1.1.20",
    "@radix-ui/react-dropdown-menu": "^2.1.24",
    "@radix-ui/react-hover-card": "^1.1.23",
    "@radix-ui/react-navigation-menu": "^1.2.22",
    "@radix-ui/react-popover": "^1.1.23",
    "@radix-ui/react-scroll-area": "^1.2.18",
    "@radix-ui/react-select": "^2.3.7",
    "@radix-ui/react-slot": "^1.3.3",
    "@radix-ui/react-tabs": "^1.1.21",
    "@tanstack/react-query": "5.102.8",
    "@tanstack/react-query-devtools": "5.102.8",
    "@tanstack/react-router": "1.170.32",
    "@tanstack/react-router-devtools": "1.167.1",
    "@tanstack/react-table": "^9.2.4",
    "@tanstack/react-virtual": "^3.14.10",
    "@xyflow/react": "^12.11.5",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "d3-dag": "^1.2.2",
    "echarts": "^6.1.0",
    "echarts-for-react": "^3.0.6",
    "elkjs": "^0.12.0",
    "fflate": "^0.8.3",
    "jotai": "^2.20.3",
    "jotai-family": "^1.1.0",
    "lucide-react": "^1.37.0",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "react-resizable-panels": "^4.12.3",
    "tailwind-merge": "^3.6.0",
    "vaul": "^1.1.2",
    "zod": "^4.5.4"
  },
  "devDependencies": {
    "@playwright/test": "1.61.1",
    "@types/node": "^26.4.0",
    "@types/react": "19.2.18",
    "@types/react-dom": "19.2.5",
    "@tailwindcss/vite": "^4.3.3",
    "@tanstack/router-vite-plugin": "1.167.35",
    "@vitejs/plugin-react": "^6.1.1",
    "jsdom": "^30.0.1",
    "tailwindcss": "^4.3.3",
    "tailwindcss-animate": "^1.0.7",
    "typescript": "^6.0.3",
    "vite": "^8.2.1",
    "vitest": "^4.1.11"
  }
}
